FLASK_SECRET_KEY=replace-with-random-hex
SERVER_HOST=127.0.0.1
SERVER_PORT=5000
REGISTER_TOKEN=replace-with-strong-registration-token
OFFLINE_AFTER_SECONDS=35
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_SECONDS=15
MAX_CONTENT_LENGTH=20971520
UPLOAD_MAX_MB=20
RATE_LIMIT_ENABLED=1
RATE_LIMIT_PER_MINUTE=300
SESSION_COOKIE_SECURE=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
# Optional: set this instead of ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=pbkdf2:sha256:...

# Hosted deployments (Railway/Render/Fly): persist SQLite and task files on a volume.
# DATA_DIR=/data
# AGENT_SOURCE_PATH=/app/agent/agent.py
# PORT, SERVER_HOST=0.0.0.0 and TRUST_PROXY_HEADERS are usually set for you by the platform.
